rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function me() { return request.auth.token.email.lower(); }
    function isOwner() { return signedIn() && me() == 'sukoonniwas@gmail.com'; }
    function isMember() {
      return isOwner() || (signedIn() && exists(/databases/$(database)/documents/orgs/sukoon/members/$(me())));
    }

    // Old private space (kept so earlier data can be copied into the team space).
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Shared team space: every team member has full rights.
    match /orgs/sukoon/{document=**} {
      allow read, write: if isMember();
    }
  }
}
